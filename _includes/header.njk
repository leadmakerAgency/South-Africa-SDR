<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#02403D" />
  <title>{% if title %}{{ title }} | South Africa SDR{% else %}Blog | South Africa SDR{% endif %}</title>
  <meta name="description" content="{% if excerpt %}{{ excerpt }}{% else %}Practical guides on outbound, SDR strategy and offshore sales teams.{% endif %}" />
  {% if canonical %}<link rel="canonical" href="{{ canonical }}" />{% else %}<link rel="canonical" href="{{ site.url }}{{ page.url }}" />{% endif %}
  <link rel="icon" href="/images/brand/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/images/brand/favicon.svg" />
  <!-- OG -->
  <meta property="og:title" content="{% if title %}{{ title }}{% else %}Blog | South Africa SDR{% endif %}" />
  <meta property="og:description" content="{% if excerpt %}{{ excerpt }}{% else %}Practical guides on outbound, SDR strategy and offshore sales teams.{% endif %}" />
  <meta property="og:type" content="{% if layout == 'blog-post.njk' %}article{% else %}website{% endif %}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  {% if featured_image %}<meta property="og:image" content="{{ site.url }}{{ featured_image }}" />{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600&family=Montserrat:wght@600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/blog.css" />
  <link rel="stylesheet" href="/redesign.css" />
  <link rel="alternate" type="application/atom+xml" title="South Africa SDR Blog" href="/feed.xml" />
</head>
<body>

<header class="blog-site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="South Africa SDR, home">
      <img src="/images/brand/lockup-horizontal-rev.svg" alt="South Africa SDR" width="180" height="32" />
    </a>
    <nav aria-label="Main">
      <ul>
        <li><a href="/why-south-africa/">Why South Africa</a></li>
        <li><a href="/services/">Services</a></li>
        <li><a href="/industries/">Industries</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/blog/" {% if blogActive %}class="active"{% endif %}>Blog</a></li>
        <li><a href="/case-studies/">Case Studies</a></li>
      </ul>
    </nav>
    <a class="btn-gold" href="/contact/">Book a call</a>
    <button class="blog-hamburger" id="blogHamburger" aria-label="Open menu" aria-expanded="false" aria-controls="blogMobileMenu">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="blog-mobile-menu" id="blogMobileMenu" hidden>
    <a href="/why-south-africa/">Why South Africa</a>
    <a href="/services/">Services</a>
    <a href="/industries/">Industries</a>
    <a href="/about/">About</a>
    <a href="/blog/" {% if blogActive %}class="active"{% endif %}>Blog</a>
    <a href="/case-studies/">Case Studies</a>
    <a href="/contact/" class="btn-gold">Book a call</a>
  </div>
</header>
