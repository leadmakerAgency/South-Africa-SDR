<script>
(function () {
  var btn = document.getElementById("blogHamburger");
  var menu = document.getElementById("blogMobileMenu");
  if (!btn || !menu) return;
  btn.addEventListener("click", function () {
    var open = btn.getAttribute("aria-expanded") === "true";
