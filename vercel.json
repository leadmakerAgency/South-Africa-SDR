{
  "buildCommand": "npm run build",
  "outputDirectory": "_site",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/book",
      "destination": "https://calendly.com/agencyleadmaker/sasdr",
      "permanent": true
    },
    {
      "source": "/book/",
      "destination": "https://calendly.com/agencyleadmaker/sasdr",
      "permanent": true
    },
    {
      "source": "/book/index.html",
      "destination": "https://calendly.com/agencyleadmaker/sasdr",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "https://calendly.com/agencyleadmaker/sasdr",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "https://calendly.com/agencyleadmaker/sasdr",
      "permanent": true
    },
    {
      "source": "/contact/index.html",
      "destination": "https://calendly.com/agencyleadmaker/sasdr",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
